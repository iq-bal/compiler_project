Sankalpa(){
    // Variable declarations
    Artha counter = 0;
    Jala sum = 0.0;
    Satya flag = true;
    Akshara grade = "A";
    Vani message = "Welcome to the custom language!";


    // Output the message
    Mantra(message);

    // For loop example
    YATRA (Artha counter = 0; counter < 5; counter = counter + 1) {
        MANTRA("Counter value: ");
        MANTRA(counter);
    }

    
}