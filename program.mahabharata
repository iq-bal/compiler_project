// global variables
Artha a = 5;
Artha b = 10;
Jala base = 2.0;
Artha exp = 3;


//function declaration
Yajna Artha Add(Artha a, Artha b) {
    Moksha a + b;
}


//function definition
Yajna Artha factorial(Artha number) {
    Artha result = 1;
    Tapas (number > 0) {
        result = result * number;
        number = number - 1;
    }
    Moksha result;
}


Sankalpa() {
    // Welcome message
    Vani welcomeMessage = "Welcome to the Utility Application!";
    Mantra(welcomeMessage);

    // Variables for calculations
    Artha a = 5;
    Artha b = 10;
    Jala base = 2.0;
    Artha exp = 3;

    // Basic arithmetic using functions
    Artha sum = Ahvana(Add, a, b);
    Mantra("Sum of a and b:");
    Mantra(sum);

   
    // Factorial calculation
    Artha factInput = 5;
    Artha factResult = Ahvana(factorial, factInput);
    Mantra("Factorial of:");
    Mantra(factInput);
    Mantra(factResult);

    

    // Decision-making examples
    Artha num = 30;
    Dharma(num < 20) {
        Mantra("Number is less than 20");
    } Adharma(num >= 20) {
        Mantra("Number is 20 or greater");
    }

    // Looping example with counters
    Mantra("Counting from 0 to 4:");
    Artha counter = 0;
    Tapas(counter < 5) {
        Mantra(counter);
        counter = counter + 1;
    }


    Artha i = 0;
    Yatra(i = 0; i < 5; i = i + 1) {
        Mantra(i);
    }

    Yatra(Artha i = 0; i < 5; i = i + 1) {
        Mantra(i);
    }

    Yatra(Artha i = 0; i < 5; i = i + 1) {
        Yatra(Artha j = 0; j < 5; j = j + 1) {
            Mantra(i);
            Mantra(j);
        }
    }


    // Nested conditional example
    Artha x = 5;
    Dharma (x > 10) {
        Mantra("x is greater than 10");
    } Vikalpa (x == 10) {
        Mantra("x is equal to 10");
    } Adharma {
        Mantra("x is less than 10");
    }

    


    // String and character handling
    Vani greeting = "Hello, User!";
    Akshara initial = 'U';
    Mantra("Greeting:");
    Mantra(greeting);
    Mantra("First character of User:");
    Mantra(initial);

    // Error handling example
    Jala invalidDivision = 0.0;
    Prayaschitta {
        Jala divResult = a / invalidDivision;
        Mantra(divResult);
    } Shanti(Exception) {
        Mantra("Caught an error: Division by zero");
    }

    // Final farewell message
    Vani farewellMessage = "Thank you for using the Utility Application!";
    Mantra(farewellMessage);
}
